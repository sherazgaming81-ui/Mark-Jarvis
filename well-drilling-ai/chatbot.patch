+.chat-call { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: var(--muted); white-space: nowrap; }
+.chat-call:hover { color: var(--blue); }
+
+.chat-input { display: flex; align-items: center; gap: 9px; padding: 12px 14px; background: white; border-top: 1px solid var(--line); }
+.chat-input input { flex: 1; min-width: 0; border: 1px solid #d6dfea; background: var(--paper); border-radius: 11px; padding: 12px 14px; font-size: 13px; color: var(--ink); }
+.chat-input input:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px #2465e81f; }
+.chat-send { width: 42px; height: 42px; flex-shrink: 0; border-radius: 11px; background: var(--navy); color: white; display: inline-flex; align-items: center; justify-content: center; transition: background .2s; }
+.chat-send:hover:not(:disabled) { background: var(--blue); }
+.chat-send:disabled { opacity: .4; cursor: default; }
+.chat-send.is-stop { background: #7b8794; }
+
+.chat-disclosure { padding: 0 14px 12px; background: white; font-size: 10.5px; line-height: 1.6; color: #8a979b; }
+.chat-disclosure a { color: var(--blue); font-weight: 600; }
+
+@media (max-width: 580px) {
+  .chat-launcher { right: 18px; bottom: 18px; padding: 13px; }
+  .chat-launcher-label { display: none; }
+  .chat-panel { right: 0; left: 0; bottom: 0; width: 100%; max-height: 88dvh; border-radius: 18px 18px 0 0; border-bottom: 0; }
+  .chat-actions { flex-direction: column; align-items: stretch; gap: 9px; }
+  .chat-actions .chat-book { width: 100%; }
+  .chat-call { justify-content: center; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .chat-launcher, .chat-launcher.is-nudging, .chat-panel, .chat-actions .chat-book.is-highlighted, .chat-typing i { animation: none !important; }
+}
