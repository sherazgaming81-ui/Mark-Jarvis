# ─────────────────────────────────────────────────────────────────────────────
# Site assistant — add at least ONE of the keys below.
#
#   Local:  copy this file to .env.local and fill it in.
#   Vercel: Project → Settings → Environment Variables → add the same names,
#           then redeploy (Deployments → ⋯ → Redeploy).
#
# The assistant tries providers in the order set by AI_PROVIDER_CHAIN and skips
# any provider whose key is missing. If every configured provider fails, the
# built-in offline knowledge base answers instead — the widget never dead-ends.
# ─────────────────────────────────────────────────────────────────────────────

# Free, fast, generous limit — recommended first choice. console.groq.com/keys
GROQ_API_KEY=

# One key, hundreds of models (free models included). openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio free tier. aistudio.google.com/apikey
GEMINI_API_KEY=

# Very fast inference (free tier available). cloud.cerebras.ai
CEREBRAS_API_KEY=

# together.ai  ·  deepinfra.com
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Order to try. Remove a provider to drop it entirely.
AI_PROVIDER_CHAIN=groq,openrouter,gemini,cerebras,together,deepinfra

# Override any model. A comma-separated list is tried in order before moving on.
# OPENROUTER free slugs rotate — set one from https://openrouter.ai/models?max_price=0
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_MODEL=gemini-2.5-flash

# Any other OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, a proxy…)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_KEY=
CUSTOM_AI_MODEL=
